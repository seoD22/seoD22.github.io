{
  "name": "seohee",
  "version": "1.0.0",
  "description": "seohee's Web Space",
  "scripts": {
    "sass:main": "sass src/scss/main.scss css/main.css --watch",
    "sass:win98": "sass win98/src/scss/main.scss win98/css/style.css --watch",
    
    "postcss:main": "postcss css/main.css -o css/main.min.css --watch",
    "postcss:win98": "postcss win98/css/style.css -o win98/css/style.min.css --watch",

    "serve": "browser-sync start --server --files \"*.html\", \"win98/*.html\", \"css/*.css\", \"win98/css/*.css\", \"win98/src/js/*.js\"",

    "dev": "npm-run-all --parallel sass:main sass:win98 postcss:main postcss:win98 serve"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "browser-sync": "^3.0.4",
    "cssnano": "^7.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.0"
  }
}